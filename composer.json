{
    "name": "particle-academy/laravel-jobs",
    "description": "Laravel package for job boards — employer job postings, public listings, and candidate applications.",
    "keywords": [
        "laravel",
        "jobs",
        "job-board",
        "hiring",
        "applications",
        "particle-academy"
    ],
    "homepage": "https://github.com/Particle-Academy/laravel-jobs",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "ParticleAcademy\\LaravelJobs\\": "src/",
            "ParticleAcademy\\LaravelJobs\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ParticleAcademy\\LaravelJobs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ParticleAcademy\\LaravelJobs\\JobsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
